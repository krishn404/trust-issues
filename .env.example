# Written by `npx convex dev` after you log in. Use the dev URL locally.
# On Vercel, use the production URL from `npx convex deploy`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Long random strings. ANALYTICS_SECRET must match `npx convex env set`.
ANALYTICS_IP_SALT=
ANALYTICS_SECRET=

# Local only. Leave unset on Vercel or nobody will be tracked.
NEXT_PUBLIC_ANALYTICS_DISABLED=
